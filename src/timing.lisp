(in-package #:cl-nyancat)

(defun %duration-to-ticks (duration fps &optional frames) "Return the tick count DURATION seconds corresponds to at FPS, or NIL when neither DURATION nor FRAMES was requested. FPS must be a positive integer. DURATION, when present, must be a real number greater than or equal to zero. FRAMES, when present, must be a positive integer. Duration is rounded up and floored at one tick, so `--duration 0.01` still draws a frame instead of exiting before anything reaches the terminal; when both limits are present, the earlier one wins." (check-type fps (integer 1 *)) (when frames (check-type frames (integer 1 *))) (let ((duration-ticks (when duration (check-type duration (real 0 *)) (max 1 (ceiling (* duration fps)))))) (if frames (if duration-ticks (min duration-ticks frames) frames) duration-ticks)))
